<%- include("partials/header", { title: "Login" }) %>
<main class="container auth-page">
  <div class="auth-card">
    <h2>Welcome Back 👋</h2>
    <p>Login to your Postify account.</p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <input class="form-control mb-3" type="email" name="email" placeholder="Email" required>
      <input class="form-control mb-4" type="password" name="password" placeholder="Password" required>
      <button class="btn btn-maroon w-100">Login</button>
    </form>
    <p class="mt-3">New here? <a href="/register">Create an account</a></p>
  </div>
</main>
<%- include("partials/footer") %>

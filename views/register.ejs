<%- include("partials/header", { title: "Register" }) %>
<main class="container auth-page">
  <div class="auth-card">
    <h2>Create Account</h2>
    <p>Join Postify today.</p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="POST" action="/register">
      <input class="form-control mb-3" name="username" placeholder="Username" required>
      <input class="form-control mb-3" type="email" name="email" placeholder="Email" required>
      <input class="form-control mb-4" type="password" name="password" placeholder="Password" minlength="6" required>
      <button class="btn btn-maroon w-100">Register</button>
    </form>
    <p class="mt-3">Already registered? <a href="/login">Login</a></p>
  </div>
</main>
<%- include("partials/footer") %>

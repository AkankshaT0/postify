<%- include("partials/header", { title: "Notifications" }) %>

<main class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Notifications 🔔</h2>
    <form method="POST" action="/users/<%= currentUser.username %>/notifications/read?_method=PATCH">
      <button class="btn btn-outline-maroon">Mark all read</button>
    </form>
  </div>

  <% if (!notifications.length) { %>
    <div class="empty-box">No notifications yet.</div>
  <% } %>

  <% notifications.forEach(n => { %>
    <div class="notification <%= n.read ? '' : 'unread' %>">
      <strong><%= n.message %></strong>
      <div class="small text-muted"><%= n.createdAt.toLocaleString() %></div>
    </div>
  <% }) %>
</main>

<%- include("partials/footer") %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Postify" %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/posts">🍷 Postify</a>
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        <li class="nav-item"><a class="nav-link" href="/posts">Posts</a></li>
        <% if (currentUser) { %>
          <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/users/<%= currentUser.username %>">Profile</a></li>
          <li class="nav-item"><a class="nav-link" href="/users/<%= currentUser.username %>/notifications">🔔</a></li>
          <li class="nav-item">
            <form action="/logout" method="POST">
              <button class="btn btn-sm btn-light">Logout</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
          <li class="nav-item"><a class="btn btn-sm btn-light" href="/register">Register</a></li>
        <% } %>
        <li class="nav-item">
          <button class="btn btn-sm btn-outline-light" onclick="toggleTheme()">🌙</button>
        </li>
      </ul>
    </div>
  </div>
</nav>
